# ==============================================================================
# CONFIGURAÇÃO DO JOB RADAR
# Copie este arquivo para .env ou exporte as variáveis no seu terminal/sistema
# ==============================================================================

# Conexão com o PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=vagas_radar
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=5

# Regras de Triagem
# Se true, aceita unicamente estágios e processos seletivos para estudantes.
# Se false, libera vagas de outras senioridades (Júnior, Pleno, etc.).
STRICT_INTERNSHIP_ONLY=true

# Permite vagas sob regime CLT (quando STRICT_INTERNSHIP_ONLY=false)
ALLOW_CLT=false

# Aceita processos seletivos formais e programas corporativos de estágio
INCLUDE_SELECTION_PROGRAMS=true

# Agendamento do Daemon
# Intervalo de tempo entre as buscas automáticas em segundo plano
SCAN_INTERVAL=2h

# Timeout por requisição externa
REQUEST_TIMEOUT=30s
